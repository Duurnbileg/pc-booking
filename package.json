{
  "name": "pc-booking",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "predev": "pnpm --filter @pc-booking/shared build",
    "dev": "concurrently -n api,web -c blue,green \"pnpm --filter @pc-booking/api dev\" \"pnpm --filter @pc-booking/web dev\"",
    "mongo": "node scripts/start-mongo.mjs",
    "build": "pnpm --filter @pc-booking/shared build && pnpm --filter @pc-booking/api build && pnpm --filter @pc-booking/web build",
    "preseed": "pnpm --filter @pc-booking/shared build",
    "seed": "pnpm --filter @pc-booking/api seed",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
