# API
# Use a local MongoDB, Atlas URI, or memory (USE_MEMORY_DB=true) for local demo
MONGODB_URI=mongodb://127.0.0.1:27017/pc-booking
USE_MEMORY_DB=false
# Use a long random secret in real environments (never commit real secrets)
JWT_SECRET=change-me-to-a-long-random-secret
WEB_ORIGIN=http://localhost:3000
PORT=4000
COOKIE_SECURE=false

# Cloudinary — use CLOUDINARY_URL or the three vars below.
# If these credentials were ever shared/exposed, rotate them in the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
