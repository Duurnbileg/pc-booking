# API
# Use a local MongoDB, Atlas URI, or memory (USE_MEMORY_DB=true) for local demo
MONGODB_URI=mongodb://127.0.0.1:27017/pc-booking
USE_MEMORY_DB=false
# Use a long random secret in real environments (never commit real secrets)
JWT_SECRET=change-me-to-a-long-random-secret
WEB_ORIGIN=http://localhost:3000
PORT=4000
COOKIE_SECURE=false

# Cloudinary — use CLOUDINARY_URL or the three vars below.
# If these credentials were ever shared/exposed, rotate them in the Cloudinary dashboard.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Web (apps/web/.env.local) — all optional.
# The web app proxies /api/* to API_PROXY_TARGET (defaults to http://localhost:4000 in dev).
# On Vercel, set API_PROXY_TARGET to the API project URL and leave NEXT_PUBLIC_API_URL unset.
# API_PROXY_TARGET=http://localhost:4000
# NEXT_PUBLIC_API_URL=

GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_MAPS_CLIENT_ID=your-client-id
GOOGLE_MAPS_CLIENT_SECRET=your-client-secret
GOOGLE_MAPS_REDIRECT_URI=your-redirect-uri
GOOGLE_MAPS_SCOPE=your-scope
GOOGLE_MAPS_ACCESS_TOKEN=your-access-token
GOOGLE_MAPS_REFRESH_TOKEN=your-refresh-token
GOOGLE_MAPS_TOKEN_TYPE=your-token-type
GOOGLE_MAPS_EXPIRES_IN=your-expires-in