# API
# Use a local MongoDB, Atlas URI, or memory (USE_MEMORY_DB=true) for local demo
MONGODB_URI=mongodb://127.0.0.1:27017/pc-booking
USE_MEMORY_DB=false
JWT_SECRET=change-me-to-a-long-random-secret
WEB_ORIGIN=http://localhost:3000
PORT=4000
COOKIE_SECURE=false

# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:4000
